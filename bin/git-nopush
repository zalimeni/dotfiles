#!/usr/bin/env bash
#
# git-nopush: temporarily block pushes from a repo (and all its worktrees).
#
# Invoke as `git nopush <cmd>` (bin/ is on PATH) or `git-nopush <cmd>`.
#
# Layers installed by `enable`:
#   1. remote.<name>.pushurl  -> dead URL, so `git push` fails at transport
#   2. .git/hooks/pre-push    -> rejects every push, including explicit URLs
#   3. .git/nopush            -> marker file read by the Claude PreToolUse guard
#
# Everything lives in the local repo (.git/config + .git/hooks) and is removed
# by `disable`. Nothing is committed and nothing leaks to other clones.
# Worktrees share .git/config and .git/hooks with the main repo, so enabling
# once covers every worktree of that repo.
#
# Usage:
#   git nopush enable  [reason...]   Block pushes in this repo
#   git nopush enable  --global      Block pushes in every repo (marker only)
#   git nopush disable [--global]    Restore pushing
#   git nopush status                Show current state
#
set -euo pipefail

BLOCKED_URL="nopush://blocked-by-git-nopush"
GLOBAL_MARKER="${HOME}/.claude/nopush"

info() { printf '  [ \033[00;34m..\033[0m ] %s\n' "$1"; }
ok()   { printf '  [ \033[00;32mOK\033[0m ] %s\n' "$1"; }
warn() { printf '  [ \033[0;33m!!\033[0m ] %s\n' "$1"; }
fail() { printf '  [\033[0;31mFAIL\033[0m] %s\n' "$1" >&2; exit 1; }

git_common_dir() {
  local dir
  dir="$(git rev-parse --git-common-dir 2>/dev/null)" || fail "not inside a git repository"
  # --git-common-dir can be relative to the worktree root
  (cd "$(git rev-parse --show-toplevel)" && cd "$dir" && pwd)
}

write_pre_push_hook() {
  local hook="$1"
  cat > "$hook" << 'HOOK'
#!/usr/bin/env bash
#
# Installed by `git nopush enable`. Remove with `git nopush disable`.
#
marker="$(git rev-parse --git-common-dir)/nopush"
[ -f "$marker" ] || exit 0

echo "" >&2
echo "  PUSH BLOCKED — no-push mode is enabled for this repo." >&2
echo "" >&2
if [ -s "$marker" ]; then
  sed 's/^/  /' "$marker" >&2
  echo "" >&2
fi
echo "  Finish local cleanup first, then re-enable pushing with:" >&2
echo "      git nopush disable" >&2
echo "" >&2
exit 1
HOOK
  chmod +x "$hook"
}

cmd_enable() {
  if [ "${1:-}" = "--global" ]; then
    mkdir -p "$(dirname "$GLOBAL_MARKER")"
    shift
    {
      echo "no-push mode: GLOBAL (all repos)"
      echo "enabled: $(date '+%Y-%m-%d %H:%M:%S')"
      [ $# -gt 0 ] && echo "reason: $*"
    } > "$GLOBAL_MARKER"
    ok "global no-push marker written: $GLOBAL_MARKER"
    warn "global mode only stops the agent guard — per-repo enable adds the git-level block"
    return
  fi

  local gitdir; gitdir="$(git_common_dir)"
  local marker="$gitdir/nopush"
  local hook="$gitdir/hooks/pre-push"

  mkdir -p "$gitdir/hooks"

  # 1. pushurl for every remote, saving anything already set
  local remote
  while read -r remote; do
    [ -z "$remote" ] && continue
    local current
    current="$(git config --local --get "remote.$remote.pushurl" || true)"
    if [ -n "$current" ] && [ "$current" != "$BLOCKED_URL" ]; then
      git config --local "nopush.saved-pushurl.$remote" "$current"
    fi
    git config --local "remote.$remote.pushurl" "$BLOCKED_URL"
    ok "remote '$remote' pushurl -> $BLOCKED_URL"
  done < <(git remote)

  # 2. pre-push hook, backing up any existing one
  if [ -e "$hook" ] && ! grep -q 'git nopush disable' "$hook" 2>/dev/null; then
    mv "$hook" "$hook.nopush-backup"
    warn "backed up existing pre-push hook to $hook.nopush-backup"
  fi
  write_pre_push_hook "$hook"
  ok "installed pre-push hook: $hook"

  # 3. marker for the agent guard
  {
    echo "no-push mode: enabled for $(git rev-parse --show-toplevel)"
    echo "enabled: $(date '+%Y-%m-%d %H:%M:%S')"
    [ $# -gt 0 ] && echo "reason: $*"
  } > "$marker"
  ok "marker written: $marker"

  echo ""
  ok "no-push mode ON — commit freely, pushes will fail. Covers all worktrees of this repo."
}

cmd_disable() {
  if [ "${1:-}" = "--global" ]; then
    rm -f "$GLOBAL_MARKER"
    ok "global no-push marker removed"
    return
  fi

  local gitdir; gitdir="$(git_common_dir)"
  local marker="$gitdir/nopush"
  local hook="$gitdir/hooks/pre-push"

  local remote
  while read -r remote; do
    [ -z "$remote" ] && continue
    local saved
    saved="$(git config --local --get "nopush.saved-pushurl.$remote" || true)"
    if [ "$(git config --local --get "remote.$remote.pushurl" || true)" = "$BLOCKED_URL" ]; then
      git config --local --unset "remote.$remote.pushurl" || true
    fi
    if [ -n "$saved" ]; then
      git config --local "remote.$remote.pushurl" "$saved"
      git config --local --unset "nopush.saved-pushurl.$remote" || true
      ok "remote '$remote' pushurl restored to $saved"
    else
      ok "remote '$remote' pushurl cleared"
    fi
  done < <(git remote)
  git config --local --remove-section nopush 2>/dev/null || true

  if [ -f "$hook" ] && grep -q 'git nopush disable' "$hook" 2>/dev/null; then
    rm -f "$hook"
    ok "removed pre-push hook"
  fi
  if [ -f "$hook.nopush-backup" ]; then
    mv "$hook.nopush-backup" "$hook"
    ok "restored previous pre-push hook"
  fi

  rm -f "$marker"
  ok "marker removed"

  echo ""
  ok "no-push mode OFF — pushing restored."
}

cmd_status() {
  local global="off"
  [ -f "$GLOBAL_MARKER" ] && global="ON"
  echo "global no-push : $global"

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "repo no-push   : (not in a git repository)"
    return
  fi

  local gitdir; gitdir="$(git_common_dir)"
  local marker="$gitdir/nopush"

  if [ -f "$marker" ]; then
    echo "repo no-push   : ON  ($(git rev-parse --show-toplevel))"
    sed 's/^/                 /' "$marker"
  else
    echo "repo no-push   : off ($(git rev-parse --show-toplevel))"
  fi

  local remote
  while read -r remote; do
    [ -z "$remote" ] && continue
    printf 'remote %-8s : push -> %s\n' "$remote" \
      "$(git config --local --get "remote.$remote.pushurl" || git config --get "remote.$remote.url" || echo '(none)')"
  done < <(git remote)

  [ -f "$gitdir/hooks/pre-push" ] && echo "pre-push hook  : present" || echo "pre-push hook  : absent"
}

case "${1:-status}" in
  enable)  shift; cmd_enable "$@" ;;
  disable) shift; cmd_disable "$@" ;;
  status)  cmd_status ;;
  -h|--help|help)
    sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) fail "unknown command: $1 (expected enable|disable|status)" ;;
esac
