{
  "permissions": {
    "allow": [
      "Read(file_path:~/supabase/**)",
      "Edit(file_path:~/supabase/**)",
      "Write(file_path:~/supabase/**)",
      "Glob(path:~/supabase/**)",
      "Grep(path:~/supabase/**)",
      "Read(file_path:~/dotfiles/**)",
      "Edit(file_path:~/dotfiles/**)",
      "Write(file_path:~/dotfiles/**)",
      "Glob(path:~/dotfiles/**)",
      "Grep(path:~/dotfiles/**)",
      "Bash(bd *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(make *)",
      "Bash(go *)",
      "Bash(golangci-lint *)",
      "Bash(ast-grep *)",
      "Bash(sg *)",
      "Bash(rg *)",
      "Bash(ripgrep *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sort *)",
      "Bash(grep *)",
      "Bash(tr *)",
      "Skill(skill:bdagent)",
      "Skill(skill:bdagent-cleanup)",
      "Skill(skill:bdexecissue)",
      "Skill(skill:bdexecplan)",
      "Skill(skill:bdloop)",
      "Skill(skill:bdplan)",
      "Skill(skill:bdreview)",
      "Skill(skill:bdstatus)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/zalimeni/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "beads@beads-marketplace": true,
    "spec-interviewer-planner@leefowlercu-agent-kit": false,
    "playwright@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "additionalWritePaths": [
      "~/go/pkg/mod/cache",
      "~/Library/Caches"
    ]
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false
}
